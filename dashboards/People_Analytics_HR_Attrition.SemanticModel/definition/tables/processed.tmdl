table processed
	lineageTag: f9da5801-01df-4ab8-a644-6e6bbaf66ee1

	/// Contagem total de colaboradores
	measure 'Total Colaboradores' = COUNTROWS(processed)
		formatString: #,##0
		displayFolder: KPIs Gerais
		lineageTag: 7dd8c303-cad0-4b4d-834d-900f8d1b88eb

	/// Numero de colaboradores que sairam
	measure 'Total Saidas' = SUM(processed[Saida])
		formatString: #,##0
		displayFolder: KPIs Gerais
		lineageTag: 6e1d07d0-954c-477e-92c3-da83a9f2680d

	/// Percentagem de colaboradores que sairam
	measure 'Taxa Turnover %' = DIVIDE(SUM(processed[Saida]), COUNTROWS(processed), 0) * 100
		formatString: 0.0"%"
		displayFolder: KPIs Gerais
		lineageTag: f327256c-3c7f-4c7d-85eb-958ae2c7f4a6

	/// Colaboradores que permaneceram
	measure 'Total Ficaram' = COUNTROWS(processed) - SUM(processed[Saida])
		formatString: #,##0
		displayFolder: KPIs Gerais
		lineageTag: 75f06b38-5325-4143-af64-d9ef50757f82

	/// Rendimento mensal medio
	measure 'Salario Medio' = AVERAGE(processed[RendimentoMensal])
		formatString: #,##0
		displayFolder: Compensacao
		lineageTag: 51976bde-110a-43fe-a8e9-87b289328a5d

	/// Salario medio de quem saiu
	measure 'Salario Medio Saidas' = CALCULATE(AVERAGE(processed[RendimentoMensal]), processed[Saida] = 1)
		formatString: #,##0
		displayFolder: Compensacao
		lineageTag: 0223b816-5d14-4e3c-a982-5e99b6030c2a

	/// Salario medio de quem ficou
	measure 'Salario Medio Ficaram' = CALCULATE(AVERAGE(processed[RendimentoMensal]), processed[Saida] = 0)
		formatString: #,##0
		displayFolder: Compensacao
		lineageTag: 55c75512-7886-4fc3-9858-337b97a2e0bd

	/// Diferenca percentual de salario entre quem ficou e quem saiu
	measure 'Gap Salarial Saida %' =
			VAR SalarioSaiu = CALCULATE(AVERAGE(processed[RendimentoMensal]), processed[Saida] = 1)
			VAR SalarioFicou = CALCULATE(AVERAGE(processed[RendimentoMensal]), processed[Saida] = 0)
			RETURN DIVIDE(SalarioFicou - SalarioSaiu, SalarioFicou, 0) * 100
		formatString: 0.0"%"
		displayFolder: Compensacao
		lineageTag: 66e68947-06ce-4a70-86f7-061b1156109d

	/// Media de satisfacao com o ambiente (1-4)
	measure 'Media Satisfacao Ambiente' = AVERAGE(processed[SatisfacaoAmbiente])
		formatString: 0.00
		displayFolder: Satisfacao
		lineageTag: c9f6d6be-e4ad-4078-9008-8e94ffcabc49

	/// Media de satisfacao com o cargo (1-4)
	measure 'Media Satisfacao Cargo' = AVERAGE(processed[SatisfacaoCargo])
		formatString: 0.00
		displayFolder: Satisfacao
		lineageTag: 662860ab-53c2-4083-b641-837b8c4573a8

	/// Media de envolvimento com o cargo (1-4)
	measure 'Media Envolvimento' = AVERAGE(processed[EnvolvimentoCargo])
		formatString: 0.00
		displayFolder: Satisfacao
		lineageTag: 7979aced-6fb2-4933-a3e0-afcb3190d877

	/// Media de equilibrio vida-trabalho (1-4)
	measure 'Media Equilibrio Vida-Trabalho' = AVERAGE(processed[EquilibrioVidaTrabalho])
		formatString: 0.00
		displayFolder: Satisfacao
		lineageTag: 7464cede-6e73-4d2c-86a5-d76d92cbdf7f

	/// Media de satisfacao com relacionamentos (1-4)
	measure 'Media Satisfacao Relacionamento' = AVERAGE(processed[SatisfacaoRelacionamento])
		formatString: 0.00
		displayFolder: Satisfacao
		lineageTag: ca0bfe1b-dbc3-43c3-add9-4f3c8ba48269

	/// Satisfacao geral media (composta)
	measure 'Satisfacao Geral Media' = AVERAGE(processed[SatisfacaoMedia])
		formatString: 0.00
		displayFolder: Satisfacao
		lineageTag: a3009102-9d80-4225-857e-9bd21328795c

	/// Idade media dos colaboradores
	measure 'Idade Media' = AVERAGE(processed[Idade])
		formatString: 0.0
		displayFolder: Demografia
		lineageTag: 22b3f872-00b9-4344-9902-bb5487377a10

	/// Distancia media casa-trabalho em km
	measure 'Distancia Media Casa' = AVERAGE(processed[DistanciaCasa])
		formatString: 0.0
		displayFolder: Demografia
		lineageTag: ac1bdca2-3036-40c7-9067-8f737fcb1325

	/// Media de anos na empresa
	measure 'Media Anos Empresa' = AVERAGE(processed[AnosNaEmpresa])
		formatString: 0.0
		displayFolder: Demografia
		lineageTag: ade1b48c-a101-4d70-a59a-3abb69cca16b

	/// Media de anos desde ultima promocao
	measure 'Media Anos Sem Promocao' = AVERAGE(processed[AnosDesdeUltimaPromocao])
		formatString: 0.0
		displayFolder: Demografia
		lineageTag: b65ee4d4-930c-4df4-a928-781e8d425646

	/// Percentagem de colaboradores que fazem horas extra
	measure '% Horas Extra' = DIVIDE(CALCULATE(COUNTROWS(processed), processed[HorasExtra] = "Sim"), COUNTROWS(processed), 0) * 100
		formatString: 0.0"%"
		displayFolder: Demografia
		lineageTag: 4b71dcc6-ed93-4407-b82a-1403d2605a94

	/// Colaboradores classificados como alto risco pelo modelo ML
	measure 'Total Alto Risco' = CALCULATE(COUNTROWS(processed), processed[RiscoSaida_Classe] = "Alto")
		formatString: #,##0
		displayFolder: Risco ML
		lineageTag: abdd931d-f72b-46ae-b32f-0cb6d224c531

	/// Colaboradores classificados como medio risco
	measure 'Total Medio Risco' = CALCULATE(COUNTROWS(processed), processed[RiscoSaida_Classe] = "Medio")
		formatString: #,##0
		displayFolder: Risco ML
		lineageTag: 2c13c202-1a5a-4ac8-aa4e-26242068e10e

	/// Colaboradores classificados como baixo risco
	measure 'Total Baixo Risco' = CALCULATE(COUNTROWS(processed), processed[RiscoSaida_Classe] = "Baixo")
		formatString: #,##0
		displayFolder: Risco ML
		lineageTag: 54ba81bc-326e-4a70-bcc3-7cf965076c1c

	/// Percentagem de colaboradores em alto risco
	measure '% Alto Risco' = DIVIDE(CALCULATE(COUNTROWS(processed), processed[RiscoSaida_Classe] = "Alto"), COUNTROWS(processed), 0) * 100
		formatString: 0.0"%"
		displayFolder: Risco ML
		lineageTag: cf5321dd-6612-42e5-b5b1-339b365baaeb

	/// Probabilidade media de saida (modelo ML)
	measure 'Risco Medio Geral' = AVERAGE(processed[RiscoSaida_Prob])
		formatString: 0.0"%"
		displayFolder: Risco ML
		lineageTag: 438b40aa-6cc5-4931-bafb-4fc1d425e07f

	/// Taxa de turnover real entre os classificados como alto risco
	measure 'Turnover Real Alto Risco %' = CALCULATE(AVERAGE(processed[Saida]), processed[RiscoSaida_Classe] = "Alto") * 100
		formatString: 0.0"%"
		displayFolder: Risco ML
		lineageTag: 9a7e2bb7-0daf-42a1-98f8-802fe8cff848

	/// Custo estimado de turnover (salario medio x 1.5 x saidas)
	measure 'Custo Estimado Turnover' =
			VAR SalarioMedio = AVERAGE(processed[RendimentoMensal])
			VAR TotalSaidas = SUM(processed[Saida])
			RETURN SalarioMedio * 1.5 * TotalSaidas
		formatString: #,##0
		displayFolder: Risco ML
		lineageTag: 50b349ed-d4df-44d6-88ab-e5ef24b97224

