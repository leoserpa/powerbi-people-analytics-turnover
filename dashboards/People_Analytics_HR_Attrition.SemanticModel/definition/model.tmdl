model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["processed","ml_feature_importance","ml_comparacao_modelos"]

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table processed
ref table ml_feature_importance
ref table ml_comparacao_modelos

ref cultureInfo en-US

